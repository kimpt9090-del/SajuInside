# 배포 URL (OG/메타데이터 절대 경로) — Vercel Production 예: https://saju-inside.vercel.app
NEXT_PUBLIC_SITE_URL=https://saju-inside.vercel.app

# 피드백 DB — local | supabase | firebase
NEXT_PUBLIC_DB_PROVIDER=local

# Supabase (provider=supabase + 클라우드 로그인/동기화)
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Supabase Dashboard → Authentication → URL Configuration:
#   Site URL / Redirect URLs에 https://your-domain/auth/callback 추가
# SQL Editor에서 supabase/schema.sql 실행

# Firebase (provider=firebase)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key

# 카카오톡 공유 (developers.kakao.com JavaScript 키)
NEXT_PUBLIC_KAKAO_JS_KEY=
